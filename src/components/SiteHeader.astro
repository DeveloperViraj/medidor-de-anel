---
import { SITE } from '../config/site';
import { PRIMARY_NAV } from '../lib/nav';
import { pagePath } from '../lib/seo';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = pagePath(Astro.url.pathname);
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
// The header only lists pages beyond the home page; the logo already goes home.
const links = PRIMARY_NAV.filter((item) => item.href !== '/');
---

<header class="border-b border-line bg-canvas/90 backdrop-blur supports-[backdrop-filter]:bg-canvas/75 sticky top-0 z-50">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-3 px-4">
    <a href="/" class="flex min-w-0 items-center gap-2.5 text-ink no-underline">
      <Logo class="size-8 shrink-0" />
      <span class="truncate font-display text-xl font-semibold tracking-tight">{SITE.name}</span>
    </a>
    <nav aria-label="Principal" class="flex shrink-0 items-center gap-1">
      {links.length > 0 && (
        <ul class="hidden items-center gap-0.5 text-sm md:flex">
          {links.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="rounded-pill px-3.5 py-2 font-medium text-ink-2 no-underline hover:bg-sunken hover:text-ink aria-[current=page]:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      )}
      <ThemeToggle />
      {/* Below 400px the name and the toggle fill the bar; the tool is the first thing on the home page anyway. */}
      <a href="/#medidor" class="btn btn-solid btn-sm max-[399px]:hidden">
        Medir agora
      </a>
    </nav>
  </div>
</header>
