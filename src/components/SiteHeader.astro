---
import { Icon } from 'astro-icon/components';
import { SITE } from '../config/site';
import { GUIDE_NAV, PRIMARY_NAV } from '../lib/nav';
import { pagePath } from '../lib/seo';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = pagePath(Astro.url.pathname);
const isCurrent = (href: string) => path === href;
---

<header class="sticky top-0 z-50 border-b border-line bg-canvas/90 backdrop-blur supports-[backdrop-filter]:bg-canvas/75">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-3 px-4">
    <a href="/" class="flex min-w-0 items-center gap-2.5 text-ink no-underline">
      <Logo class="size-8 shrink-0" />
      <span class="truncate font-display text-xl font-semibold tracking-tight">{SITE.name}</span>
    </a>
    <nav aria-label="Principal" class="flex shrink-0 items-center gap-1">
      <ul class="hidden items-center gap-0.5 text-sm lg:flex">
        {PRIMARY_NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="rounded-pill px-3 py-2 font-medium text-ink-2 no-underline hover:bg-sunken hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
      {/* Below 400px the name and the toggle fill the bar; the tool is the first thing on the home page anyway. */}
      <a href="/#medidor" class="btn btn-solid btn-sm max-[399px]:hidden">
        Medir agora
      </a>
      <details class="menu relative lg:hidden" data-header-menu>
        <summary
          class="flex size-10 cursor-pointer list-none items-center justify-center rounded-pill text-ink-2 hover:bg-sunken hover:text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Icon name="lucide:menu" class="menu-open size-5" aria-hidden="true" />
          <Icon name="lucide:x" class="menu-close size-5" aria-hidden="true" />
        </summary>
        <div class="absolute top-12 right-0 w-72 max-w-[calc(100vw-2rem)] rounded-lg border border-line bg-surface p-2 shadow-md">
          <ul class="text-sm">
            <li>
              <a
                href="/"
                aria-current={isCurrent('/') ? 'page' : undefined}
                class="block rounded-sm px-3 py-2.5 font-semibold text-ink no-underline hover:bg-sunken aria-[current=page]:text-accent-ink"
              >
                Medidor de anel online
              </a>
            </li>
            {[...PRIMARY_NAV, ...GUIDE_NAV].map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class="block rounded-sm px-3 py-2.5 font-medium text-ink-2 no-underline hover:bg-sunken hover:text-ink aria-[current=page]:text-accent-ink"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </nav>
  </div>
</header>

<style>
  .menu :global(.menu-close) {
    display: none;
  }
  .menu[open] :global(.menu-open) {
    display: none;
  }
  .menu[open] :global(.menu-close) {
    display: block;
  }
</style>

<script>
  // Close the phone menu on a tap outside it or on Escape.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-header-menu]')) {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') menu.open = false;
    });
  }
</script>
