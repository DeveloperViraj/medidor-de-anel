---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página não encontrada"
  description="Esta página não existe ou mudou de endereço. Volte para o medidor de anel online e descubra o seu aro."
  noindex
>
  <div class="mx-auto max-w-2xl px-4 py-20 text-center">
    <p class="eyebrow">Erro 404</p>
    <h1 class="mt-2 text-4xl">Esta página não existe</h1>
    <p class="mt-4 text-ink-2">O endereço pode ter mudado ou ter sido digitado errado.</p>
    <a href="/" class="btn btn-solid mt-8">
      Ir para o medidor de anel
    </a>
  </div>
</BaseLayout>
